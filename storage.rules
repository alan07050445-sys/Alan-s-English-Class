rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── v337: 多位老師共管 ────────────────────────────────────
    // ⚠ Firebase 平台限制：Storage 規則「讀不到 Firestore」，所以不能沿用
    //    資料庫的 admins 名單。要讓新老師也能【上傳檔案／圖片】，
    //    必須把他的 Google 信箱加進下面這個清單，然後重新發布規則。
    //    （其他權限——編輯課程、看成績——走資料庫名單，不用改這裡。）
    function isTeacher() {
      return request.auth != null
             && request.auth.token.email.lower() in [
                  'alan07050445@gmail.com'
                  // , '新老師的信箱@gmail.com'   ← 要給上傳權限就把這行前面的 // 拿掉並填入
                ];
    }

    // ── PDF 檔案 ────────────────────────────────────────────
    // 所有人可讀（學生下載練習卷）
    // 只有老師可以上傳 / 刪除
    // （單字卡自訂圖片也存在 pdfs/flashcards/，沿用同一條規則）
    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── 學生作業照片（v263「上傳作業」題型）─────────────────
    // 學生只能傳到自己的資料夾；只有本人和老師看得到
    match /submissions/{uid}/{allPaths=**} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isTeacher());
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
