rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ──────────────────────────────────────────────
    // v337: 多位老師共管。
    //   isOwner()   = Alan 本人（寫死，永遠不會被鎖在外面、也不會被別人移除）
    //   isTeacher() = 擁有者 或 admins 名單裡的老師（名單存資料庫，後台就能增減）
    function isOwner() {
      return request.auth != null
             && request.auth.token.email.lower() == 'alan07050445@gmail.com';
    }
    function isTeacher() {
      return request.auth != null
             && (isOwner()
                 || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // ── 管理者名單 ──────────────────────────────────────────
    // ⚠ 只有「擁有者」能新增/移除管理者——避免權限擴散（老師無法自己再加老師、
    //    也無法把別的老師踢掉）。讀取：本人只能讀自己那筆（前端判斷是不是老師用），
    //    擁有者可讀全部（後台管理畫面用）。
    match /admins/{adminEmail} {
      allow read: if isOwner()
                  || (request.auth != null && request.auth.token.email.lower() == adminEmail);
      allow write: if isOwner();
    }

    // ── 課程內容（G3/G4/G5/G6 都在 class 集合，G2 在 class-g2）──
    // 公開可讀（維持現狀，避免鎖住學生）；只有老師可寫。
    match /class/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /class-g2/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── 學生個人進度（成績 / 完成度 / 錯題）─────────────────
    // 只有「本人」或「老師」可讀；只有本人可寫。
    match /progress/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isTeacher());
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // ── 學生 XP / Streak / Badges（users 集合）──────────────
    // 本人可讀寫；老師可讀。
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
      allow read: if isTeacher();
    }

    // ── 班級名單（roster）──────────────────────────────────
    // 登入者可讀（顯示同學名字等）；只有老師可寫。
    match /roster/{docId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }

    // ── 全班合作目標（coop）────────────────────────────────
    // 登入者可讀；只有老師可寫（維持現狀）。
    match /coop/{docId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }

    // ── 2026 暑假選課 ───────────────────────────────────────
    // 時段本身沒有個資，公開讀取讓家長只看到「可選 / 已額滿」。
    // 家長留下的姓名與聯絡方式則只允許 Alan 老師查看。
    match /summerSlots2026/{slotId} {
      allow read: if true;
      allow create, delete: if isTeacher();
      allow update: if isTeacher() || (
        resource.data.status == 'open'
        && request.resource.data.status == 'booked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedAt'])
        && existsAfter(/databases/$(database)/documents/summerBookings2026/$(slotId))
      ) || (
        resource.data.status == 'booked'
        && request.resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedAt'])
        && getAfter(/databases/$(database)/documents/summerBookings2026/$(slotId)).data.status == 'cancel_requested'
      );
    }

    match /summerBookings2026/{slotId} {
      allow create: if request.resource.data.keys().hasAll([
          'slotId', 'date', 'start', 'end', 'studentName', 'bookingGroup', 'changeToken', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'slotId', 'date', 'start', 'end', 'studentName', 'bookingGroup', 'changeToken', 'status', 'createdAt'
        ])
        && request.resource.data.slotId == slotId
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 50
        && request.resource.data.bookingGroup is string
        && request.resource.data.bookingGroup.size() > 0
        && request.resource.data.bookingGroup.size() <= 80
        && request.resource.data.changeToken is string
        && request.resource.data.changeToken.size() > 10
        && getAfter(/databases/$(database)/documents/summerSlots2026/$(slotId)).data.status == 'booked';
      allow update: if isTeacher() || (
        resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancel_requested'
        && request.resource.data.changeToken == resource.data.changeToken
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      ) || (
        resource.data.status == 'cancel_requested'
        && request.resource.data.status == 'confirmed'
        && getAfter(/databases/$(database)/documents/summerSlots2026/$(slotId)).data.status == 'booked'
      );
      allow read, delete: if isTeacher();
    }

    // ── 其他未列出的文件 ───────────────────────────────────
    // 關鍵修正：舊版這裡是 "allow read: if request.auth != null"，
    // 由於 Firestore 規則是 OR 邏輯，那條會「架空」上面 progress 的限制，
    // 讓任何登入的人都能讀到別人的成績與錯題。
    // 改成「預設拒絕讀取、只有老師可寫」，洩漏即關閉。
    //
    // ⚠ v337 再修一次：這條原本是 isTeacher()，但因為規則是 OR 邏輯，
    //   它會「架空」上面 /admins 的擁有者限制——任何老師都能改管理者名單
    //   （自己加人、把別人踢掉）＝權限擴散。改成 isOwner() 之後：
    //   已列出的集合（class/roster/progress/暑假…）照原本的老師權限運作，
    //   未列出的集合則只有擁有者能寫，/admins 也才真正鎖住。
    match /{document=**} {
      allow write: if isOwner();
    }
  }
}
