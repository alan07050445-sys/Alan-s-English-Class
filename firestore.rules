rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ──────────────────────────────────────────────
    // v337: 多位老師共管。
    //   isOwner()   = Alan 本人（寫死，永遠不會被鎖在外面、也不會被別人移除）
    //   isTeacher() = 擁有者 或 admins 名單裡的老師（名單存資料庫，後台就能增減）
    function isOwner() {
      return request.auth != null
             && request.auth.token.email.lower() == 'alan07050445@gmail.com';
    }
    function isTeacher() {
      return request.auth != null
             && (isOwner()
                 || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // ── 管理者名單 ──────────────────────────────────────────
    match /admins/{adminEmail} {
      allow read: if isOwner()
                  || (request.auth != null && request.auth.token.email.lower() == adminEmail);
      allow write: if isOwner();
    }

    // ── v342: 集點（星星）──────────────────────────────────
    // v392 資安：一筆文件最多 1000 筆 entries。協同老師可以無上限給星星，而星星能換東西，
    //   等於可以無限發行點數；1000 筆＝1000 次手動加減，正常用一輩子也用不完。
    match /stars/{studentEmail} {
      allow read: if isTeacher()
                  || (request.auth != null && request.auth.token.email.lower() == studentEmail);
      allow write: if isTeacher()
                   && (!('entries' in request.resource.data)
                       || request.resource.data.entries.size() <= 1000);
    }

    // ── 課程內容（G3/G4/G5/G6 都在 class 集合，G2 在 class-g2）──
    // 公開可讀（維持現狀，避免鎖住學生）；只有老師可寫。
    //
    // ⚠ v392 資安（critical，實測過）：class/summer_meta 不是課程內容，是「暑假派發清單」，
    //   結構為 students.{email} = { name, weeks }（data-summer.js 的 _metaDoc）。
    //   在 allow read: if true 之下，完全未登入、只帶公開 apiKey 就能下載：
    //     curl '.../documents/class/summer_meta?key=AIza...'  → HTTP 200、62,674 bytes
    //   內含 12 個 email（11 個是 @stu.kcislk.ntpc.edu.tw 的學號信箱）＋真實姓名
    //   ＋每人每週完成的題目清單＝11 位未成年學生的個資公開外洩。
    //   已逐份掃過 31 個公開 class 文件，這是唯一含個資的一份，所以只挑它出來擋，
    //   其他課程內容維持公開（不會鎖住學生）。
    //   已確認唯一的讀取點 data-summer.js:184/241 subscribeSummerMeta 只在學生登入後才呼叫，
    //   沒有任何未登入路徑會讀它。
    match /class/{docId} {
      allow read: if docId != 'summer_meta' || request.auth != null;
      allow write: if isTeacher();
    }
    match /class-g2/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ── 學生個人進度（成績 / 完成度 / 錯題）─────────────────
    match /progress/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isTeacher());
      allow write: if request.auth != null
                   && request.auth.uid == userId;
      // v448（Alan：「亂買東西要退掉」）：老師可以把學生買的吉祥物裝扮退掉。
      //   星星是「賺到的 − 花掉的」算出來的，所以退費＝把東西從 mx.owned 拿掉，點數自己就回去。
      //   ⚠ 只准動 mx 這一個欄位——成績、完成度、錯題老師一律不能改（那是學生自己的紀錄）。
      allow update: if isTeacher()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mx']);
    }

    // ── 學生 XP / Streak / Badges（users 集合）──────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
      allow read: if isTeacher();
    }

    // ── 班級名單（roster）──────────────────────────────────
    match /roster/{docId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }

    // ── 全班合作目標（coop）────────────────────────────────
    match /coop/{docId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }

    // ── 2026 暑假選課 ───────────────────────────────────────
    match /summerSlots2026/{slotId} {
      allow read: if true;
      allow create, delete: if isTeacher();
      allow update: if isTeacher() || (
        resource.data.status == 'open'
        && request.resource.data.status == 'booked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedAt'])
        && existsAfter(/databases/$(database)/documents/summerBookings2026/$(slotId))
      ) || (
        resource.data.status == 'booked'
        && request.resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookedAt'])
        && getAfter(/databases/$(database)/documents/summerBookings2026/$(slotId)).data.status == 'cancel_requested'
      );
    }

    match /summerBookings2026/{slotId} {
      allow create: if request.resource.data.keys().hasAll([
          'slotId', 'date', 'start', 'end', 'studentName', 'bookingGroup', 'changeToken', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'slotId', 'date', 'start', 'end', 'studentName', 'bookingGroup', 'changeToken', 'status', 'createdAt'
        ])
        && request.resource.data.slotId == slotId
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 50
        && request.resource.data.bookingGroup is string
        && request.resource.data.bookingGroup.size() > 0
        && request.resource.data.bookingGroup.size() <= 80
        && request.resource.data.changeToken is string
        && request.resource.data.changeToken.size() > 10
        && getAfter(/databases/$(database)/documents/summerSlots2026/$(slotId)).data.status == 'booked';
      allow update: if isTeacher() || (
        resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancel_requested'
        && request.resource.data.changeToken == resource.data.changeToken
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      ) || (
        resource.data.status == 'cancel_requested'
        && request.resource.data.status == 'confirmed'
        && getAfter(/databases/$(database)/documents/summerSlots2026/$(slotId)).data.status == 'booked'
      );
      allow read, delete: if isTeacher();
    }

    // ── 其他未列出的文件 ───────────────────────────────────
    match /{document=**} {
      allow write: if isOwner();
    }
  }
}
